{
  "name": "droidperf",
  "version": "0.1.2",
  "description": "Android Gradle performance auditor and auto-fixer.",
  "author": "Rudra Dave",
  "homepage": "https://github.com/rudradave1/droidperf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudradave1/droidperf.git"
  },
  "bugs": {
    "url": "https://github.com/rudradave1/droidperf/issues"
  },
  "license": "MIT",
  "bin": {
    "droidperf": "bin/droidperf.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "android",
    "gradle",
    "performance",
    "build",
    "audit",
    "cli"
  ],
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node -c bin/droidperf.js && node -c src/commands/audit.js && node -c src/commands/fix.js",
    "prepublishOnly": "npm test && npm run -s lint"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "diff": "^7.0.0"
  }
}
